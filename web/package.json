{
  "name": "x-player-web",
  "private": true,
  "version": "1.0.0",
  "description": "Landing page for X-Player. Two sections: the proof, and where to get it.",
  "scripts": {
    "dev": "node scripts/sync-player.mjs && next dev --port 5175",
    "build": "node scripts/sync-player.mjs && node scripts/make-icons.mjs && next build && node scripts/postbuild.mjs",
    "start": "next start --port 5175",
    "typecheck": "node scripts/sync-player.mjs && tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "e2e": "node e2e/run.mjs",
    "player": "node scripts/sync-player.mjs",
    "serve": "node scripts/serve-out.mjs",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "motion": "^13.1.1",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "oxlint": "^1.79.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2"
  },
  "license": "MIT"
}
